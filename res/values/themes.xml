<resources>
    <style name="Theme.Walkie" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/pitch</item>
        <item name="android:colorBackground">@color/pitch</item>
        <item name="android:statusBarColor">@color/pitch</item>
        <item name="android:navigationBarColor">@color/pitch</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/white</item>
        <item name="android:windowSplashScreenBackground">@color/pitch</item>
    </style>

    <style name="Theme.Walkie.Dialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorAccent">@color/white</item>
        <item name="android:colorBackground">@color/dialog</item>
    </style>
</resources>
